// Cloudflare Workers: serve the static export in out/ (next build with output: 'export')
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "compatibility_date": "2026-09-01",
  // Serve only on the custom domain daichihotta.com, not on *.workers.dev
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
